# Copy to .env for local development. Never commit .env or a real key.
# Leave the key empty to use the offline mock generator (pytest and ./scripts/run_dev.sh).

# anthropic | openai | groq
# groq uses the OpenAI-compatible API at https://api.groq.com/openai/v1
# and the same ASK_ASHISH_LLM_API_KEY (a Groq key). Leave it empty for the mock.
ASK_ASHISH_LLM_PROVIDER=anthropic
ASK_ASHISH_LLM_API_KEY=

# Optional. Empty uses a provider default (see README). Not a claim about production.
# anthropic: claude-sonnet-4-5
# openai: gpt-4o-mini
# groq: llama-3.3-70b-versatile
# ASK_ASHISH_ANSWER_MODEL=

# 1 = refuse to start without ASK_ASHISH_LLM_API_KEY (Railway image default).
# 0 = allow the mock generator so local dev and CI work with no key.
ASK_ASHISH_REQUIRE_LLM=0

# hash = offline bag-of-words vectors (no model download).
# minilm = sentence-transformers/all-MiniLM-L6-v2 (pip install '.[minilm]').
ASK_ASHISH_EMBEDDINGS=hash
ASK_ASHISH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

ASK_ASHISH_TOP_K=4
ASK_ASHISH_CHUNK_SIZE=800
ASK_ASHISH_CHUNK_OVERLAP=120
ASK_ASHISH_MAX_TOKENS=600
ASK_ASHISH_RATE_LIMIT_PER_HOUR=20
ASK_ASHISH_CORPUS_DIR=corpus
ASK_ASHISH_PERSIST_DIR=.chroma

# Optional retrieval floor. Empty uses a mode default (hash is looser than MiniLM).
# ASK_ASHISH_MIN_SCORE=0.3
